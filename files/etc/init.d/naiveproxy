#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    # сервер 1: config.json -> socks 127.0.0.1:1080
    procd_open_instance main
    procd_set_param command /usr/bin/naive /etc/naiveproxy/config.json
    procd_set_param respawn
    procd_close_instance

    # сервер 2: config2.json -> socks 127.0.0.1:1081
    procd_open_instance second
    procd_set_param command /usr/bin/naive /etc/naiveproxy/config2.json
    procd_set_param respawn
    procd_close_instance
}
